{
  "name": "spendr",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:types": "supabase gen types typescript --linked > types/database.ts"
